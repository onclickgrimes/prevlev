# Copie para .env e preencha somente no computador que executa o backend.
# Node.js 24; npm run server carrega .env. Reinicie após alterar este arquivo.
BIND=127.0.0.1
PORT=8787
PREVLEV_TOKEN=SUBSTITUA_POR_UM_TOKEN_EXCLUSIVO_LOCAL
ALLOWED_ORIGINS=chrome-extension://SUBSTITUA_PELO_ID_EXATO_DA_EXTENSAO
DATA_DIR=./data/history

# Serviço OmniProviders já existente. Use uma origem, sem /v1 ou outros caminhos.
AI_PROVIDER=omni
OMNI_BASE_URL=http://127.0.0.1:7814
# Somente a chave EXISTENTE de acesso ao serviço Omni, se ele exigir autenticação.
# Não use aqui uma chave de provedor/OAuth. Não envie segredos no chat.
OMNI_API_KEY=
OMNI_TIMEOUT_MS=120000

# Alternativa explícita para instalações que já usam o adaptador compatível:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://SEU_PROVEDOR.example/v1
# AI_API_KEY=CONFIGURE_APENAS_LOCALMENTE_NO_SERVIDOR
# AI_MODEL=ID_EXATO_DO_MODELO_DE_TEXTO
# AI_IMAGE_MODEL=ID_EXATO_DO_MODELO_DE_IMAGEM
